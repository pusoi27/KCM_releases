# Email Configuration for Stdytime
# Copy this file to .env and fill in your SMTP settings

# SMTP Server Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Sender Email Credentials
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-specific-password

# Note for Gmail Users:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Generate an "App Password" at https://myaccount.google.com/apppasswords
# 3. Use the 16-character password in SENDER_PASSWORD above
# 4. Do NOT use your regular Gmail password

# Alternative Email Providers:
# Outlook/Office365: smtp-mail.outlook.com, port 587
# Yahoo Mail: smtp.mail.yahoo.com, port 587 (requires app-specific password)
# SendGrid: smtp.sendgrid.net, port 587

# -----------------------------------------------------
# App Security / Deployment Settings
# -----------------------------------------------------
# Required in production (Render)
SECRET_KEY=replace-with-a-long-random-secret

# Set to production in hosted environments
APP_ENV=development

# HTTPS cookie security (true for Render production)
COOKIE_SECURE=false

# Secret used to verify machine-bound license keys.
# Keep this in sync with the key generation process used when issuing paid licenses.
STDYTIME_LICENSE_SECRET=replace-with-license-signing-secret

# -----------------------------------------------------
# LemonSqueezy License Integration
# -----------------------------------------------------
# 1. Go to LemonSqueezy Dashboard → Settings → API
#    Create an API key and paste it below.
LS_API_KEY=

# API-only mode (recommended true when you do not use webhooks)
LS_API_ONLY_MODE=true

# Cache LemonSqueezy validation result between 1h and 4h (seconds).
# Values outside the range are clamped automatically.
LS_CACHE_TTL_SECONDS=14400

# Grace window for temporary LS/network outages, in hours.
LS_GRACE_HOURS=24

# 2. Go to LS Dashboard → Webhooks → Add webhook
#    URL: https://<your-host>/webhooks/lemonsqueezy
#    Events to subscribe: license_key_created, license_key_activated,
#      license_key_expired, license_key_disabled,
#      subscription_updated, subscription_cancelled
#    Copy the signing secret LS generates and paste it below.
LS_WEBHOOK_SECRET=

# How it works
# ------------
# • When the instructor enters their email at startup, the app validates it
#   against the customer_email recorded in the activated LemonSqueezy license.
# • If LS_API_KEY is not set the app falls back to trusting the locally stored
#   license status (offline mode).
# • Set DEV_LICENSE_BYPASS=true in development to skip license checks entirely.

# Optional: database location override (e.g., /var/data/Stdytime.db on Render disk)
# DB_PATH=data/Stdytime.db

# Optional one-time admin bootstrap (leave blank after initial setup)
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# Optional operational toggles
# ENABLE_PUBLIC_EXIT_ROUTE=false
# ENABLE_VERSION_AUTOBUMP=true
# DEBUG_CACHE=false

# -----------------------------------------------------
# Private Software Update Gateway (recommended)
# -----------------------------------------------------
# Base URL of your private update API service (no trailing slash).
# Example: https://updates.yourdomain.com
SW_UPDATE_GATEWAY_URL=

# Optional static bearer token required by your gateway.
# Leave empty if gateway validates only per-machine/license headers.
SW_UPDATE_GATEWAY_TOKEN=

# Optional HMAC proof secret shared between app and gateway.
# When set, app sends X-Stdytime-Proof headers for request authenticity checks.
SW_UPDATE_CLIENT_PROOF_SECRET=

# Update channel requested by this app instance (stable/beta/canary)
SW_UPDATE_CHANNEL=stable

# Request timeout for gateway check/ticket calls.
SW_UPDATE_GATEWAY_TIMEOUT_SECONDS=25

# Optional override for direct repository mode.
# If left empty, app behavior is automatic:
# - gateway URL set  -> gateway mode
# - gateway URL empty -> direct repo mode
SW_UPDATE_ALLOW_DIRECT_GITHUB_FALLBACK=

# Legacy direct GitHub source (used only when fallback=true).
SW_UPDATE_REPO_URL=https://github.com/pusoi27/stdytime_releases

# Optional token for private GitHub fallback mode.
SW_UPDATE_GITHUB_TOKEN=

# Require SHA-256 verification before applying any downloaded update package.
SW_UPDATE_REQUIRE_CHECKSUM=true

# Require minisign signature verification before applying downloaded update package.
# Set true after you publish .minisig sidecar files for each release.
SW_UPDATE_REQUIRE_SIGNATURE=false

# minisign public key used to verify update package signatures.
# Example format: RWQpQj3u6w3JQx8l7g... (single line)
SW_UPDATE_MINISIGN_PUBLIC_KEY=

# minisign executable name/path (default assumes minisign is in PATH).
SW_UPDATE_MINISIGN_BIN=minisign

